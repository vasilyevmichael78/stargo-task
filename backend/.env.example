LLM_PROVIDER=ollama
LLM_TIMEOUT_SECONDS=180
LLM_MAX_RETRIES=1
# Candidate default, not quality-validated. Download separately after installing Ollama.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
# Alternative installed candidate: uncomment this line and remove the other model line.
# OLLAMA_MODEL=qwen3.5:4b
# Disable optional reasoning for bounded structured-output processing.
OLLAMA_THINK=false
OLLAMA_NUM_CTX=8192
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
AGENT_A_SYSTEM_PROMPT_PATH=prompts/extraction_system.txt
AGENT_B_SYSTEM_PROMPT_PATH=prompts/risk_graph_system.txt
AGENT_REPAIR_SYSTEM_PROMPT_PATH=prompts/repair_system.txt
DATABASE_PATH=data/mail_risk.sqlite3
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
RISK_CONTEXT_PATH=policies/risk_context.json
