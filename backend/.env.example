LLM_PROVIDER=ollama
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=1
# Candidate default, not quality-validated. Download separately after installing Ollama.
OLLAMA_BASE_URL=http://localhost:11434
